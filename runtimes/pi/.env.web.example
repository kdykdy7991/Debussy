# Copy this file to .env.web.local for machine-specific settings.
# .env.web.local is ignored by Git.

PI_WEB_UI_PORT=5173
PI_WEB_SERVER_PORT=8765

# Optional overrides. Defaults are derived from the ports above.
# VITE_PI_WS_URL=ws://127.0.0.1:8765/api/pi/v1/ws
# PI_WEB_ALLOWED_ORIGIN=http://127.0.0.1:5173

# Optional fixed local token. When omitted, the startup script generates one
# for the lifetime of the process.
# PI_WEB_TOKEN=replace-with-openssl-rand-hex-32

# Full local Admin Workbench: `npm run dev:admin` starts PostgreSQL + Redis,
# generates local-only authentication material, and then starts this web stack.
# Optional infrastructure port overrides:
# PI_ADMIN_DEV_POSTGRES_PORT=15432
# PI_ADMIN_DEV_REDIS_PORT=16379
# PI_ADMIN_DEV_POSTGRES_IMAGE=postgres:17-alpine
# PI_ADMIN_DEV_REDIS_IMAGE=redis:7-alpine
