{
	"name": "@earendil-works/pi-server",
	"version": "0.83.0",
	"description": "experimental server package for pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		},
		"./websocket": {
			"types": "./dist/transports/websocket/index.d.ts",
			"import": "./dist/transports/websocket/index.js"
		},
		"./coding-agent": {
			"types": "./dist/coding-agent/index.d.ts",
			"import": "./dist/coding-agent/index.js"
		},
		"./web": {
			"types": "./dist/web/index.d.ts",
			"import": "./dist/web/index.js"
		},
		"./legacy": {
			"types": "./dist/legacy/index.d.ts",
			"import": "./dist/legacy/index.js"
		}
	},
	"bin": {
		"server": "./dist/legacy/cli.js",
		"pi-web": "./dist/web/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/legacy/cli.js dist/web/cli.js && shx cp -r src/persistence/postgres/migrations dist/persistence/postgres/migrations",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"pi",
		"server"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.83.0",
		"@earendil-works/pi-coding-agent": "^0.83.0",
		"@earendil-works/pi-protocol": "^0.83.0",
		"@modelcontextprotocol/client": "2.0.0",
		"busboy": "1.6.0",
		"fflate": "0.8.2",
		"ipaddr.js": "2.5.0",
		"ioredis": "6.0.0",
		"jose": "6.2.8",
		"minio": "8.0.7",
		"postgres": "3.4.9",
		"undici": "8.5.0",
		"ws": "8.21.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@modelcontextprotocol/server": "2.0.0",
		"@types/busboy": "1.5.4",
		"@types/ws": "8.18.1",
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
