{
	"name": "@earendil-works/pi-web",
	"version": "0.83.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:embed": "PI_WEB_TARGET=embed vite",
		"dev:admin": "PI_WEB_TARGET=admin vite",
		"build:admin": "tsgo --noEmit -p tsconfig.json && PI_WEB_TARGET=admin vite build",
		"build:embed": "tsgo --noEmit -p tsconfig.json && PI_WEB_TARGET=embed vite build",
		"build": "npm run build:admin && npm run build:embed",
		"test": "vitest --run",
		"typecheck": "tsgo --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@earendil-works/pi-client": "^0.83.0",
		"@earendil-works/pi-protocol": "^0.83.0",
		"@skdy/avatar": "file:../../../../packages/avatar",
		"@streamdown/cjk": "1.0.3",
		"@streamdown/code": "1.1.1",
		"@streamdown/math": "1.0.2",
		"@streamdown/mermaid": "1.0.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"streamdown": "2.5.0"
	},
	"devDependencies": {
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"vite": "8.2.0",
		"vitest": "4.1.9"
	}
}
