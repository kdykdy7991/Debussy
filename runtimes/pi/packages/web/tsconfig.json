{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals"],
		"paths": {
			"@earendil-works/pi-client": ["../client/src/index.ts"],
			"@earendil-works/pi-protocol": ["../protocol/src/index.ts"],
			"@skdy/avatar": ["../../../../packages/avatar/src/index.ts"],
			"@rive-app/canvas": ["./types/stubs/rive-app-canvas.d.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "vite.config.ts", "types/**/*.d.ts"]
}
