 for(const bad of [{...owner,tenantId:ids.otherTenant},{...owner,integrationId:ids.otherIntegration},{...owner,principalId:ids.otherPrincipal}]){
  expect(await taskRepos.conversations.get(bad,ids.conversation)).toBeUndefined();
  expect(await taskRepos.events.list(bad,ids.conversation,{limit:100})).toEqual([]);
  expect(await taskRepos.summaries.getLatest(bad,ids.conversation)).toBeUndefined();
  expect(await taskRepos.events.append(bad,{conversationId:ids.conversation,eventType:'proof',payload:{}})).toBeUndefined();
 }
 for(const [tenant,integration,ownerId] of [[ids.otherTenant,ids.integration,ids.principal],[ids.tenant,ids.otherIntegration,ids.principal],[ids.tenant,ids.integration,ids.otherPrincipal]])
  await expect(client.run(`insert into conversation_events(id,tenant_id,source,integration_id,owner_principal_id,conversation_id,sequence,event_type,payload)
  values ($1,$2,'orchestration',$3,$4,$5,99,'proof','{}')`,randomUUID(),tenant,integration,ownerId,ids.conversation)).rejects.toMatchObject({code:'23503'});
 await expect(client.run(`insert into conversations(id,tenant_id,source,integration_id,configuration_id,orchestration_version_id,owner_principal_id,status)
 values ($1,$2,'orchestration',$3,$4,$5,$6,'active')`,randomUUID(),ids.tenant,ids.otherIntegration,ids.config,ids.versionA,ids.principal)).rejects.toMatchObject({code:'23503'});
});
