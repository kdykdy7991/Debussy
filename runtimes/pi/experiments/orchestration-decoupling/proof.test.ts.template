import { estimateContextSnapshot } from '@SOURCE@/agent-v2/context.ts';

const schema = `decoupling_proof_${process.pid}_${Date.now()}`;
const client = new PostgresClient({url: process.env.PI_ORCHESTRATION_TEST_DATABASE_URL, searchPath: schema});
const ids = Object.fromEntries(['tenant','otherTenant','config','otherConfig','integration','otherIntegration','versionA','versionB','principal','otherPrincipal','conversation','work','turn'].map(k => [k,randomUUID()]));
let root, taskRepos, chatRepos;
const inputSchema = { type:'object', properties:{ticket_id:{type:'string'}}, required:['ticket_id'] };
function compile(id, body='A', prefix='orv') {
 const result = compileRuntimeSpec({
  publishedAppVersionId: `${prefix}_${id}`,
  agent:{prompt:`Task rules ${body}`,model:{provider:'fake',modelId:'test'},contextPolicy:{maxContextTokens:16000}},
  catalog:{models:[{provider:'fake',modelId:'test'}],tools:[],knowledgeBases:[]},
  skills:[{skillId:'skill_proof',revision:body==='A'?1:2,sourceHash:sha256Hex(body),name:'analyze',description:'Analysis',instructionText:`# ${body}`,disableModelInvocation:false}],
  mcpServers:[{mcpServerId:'mcp_proof',revision:1,transport:'streamable_http',endpoint:'https://unused.invalid/mcp',authentication:'bearer',tools:[{name:'getAlertStats',description:'Read stats',inputSchema,inputSchemaHash:sha256Hex(canonicalJson(inputSchema))}]}],
 });
 if (!result.ok) throw new Error(result.errors.join('\n'));
 return result;
}
const a=compile(ids.versionA), b=compile(ids.versionB,'B');
const owner={tenantId:ids.tenant,integrationId:ids.integration,principalId:ids.principal};
const principal={...owner,publishedAppId:null,tokenId:'proof',principalType:'service'};
const request={principal,conversationId:ids.conversation,turnId:ids.turn,text:'{"ticket_id":"TK001"}'};
const trace=[];
const resolveTask=vi.fn(async(scope,record,turnId)=>{
 trace.push('resolve');
 const rows=await client.run(`select v.* , w.request_contract from orchestration_work_items w
 join prototype_versions v on v.tenant_id=w.tenant_id and v.id=w.orchestration_version_id and v.configuration_id=w.configuration_id
 where w.tenant_id=$1 and w.integration_id=$2 and w.principal_id=$3 and w.conversation_id=$4 and w.execution_turn_id=$5
 and w.orchestration_version_id=$6`,scope.tenantId,scope.integrationId,scope.principalId,record.conversationId,turnId,record.orchestrationVersionId);
 if(rows.length!==1) return undefined;
 const row=rows[0];
 return {runtimeSpec:row.runtime_spec,runtimeSpecHash:row.runtime_spec_hash,sourceAgentRevision:null,
 source:{kind:'orchestration',ownerId:scope.integrationId,versionId:`orv_${row.id}`,contract:row.request_contract}};
});
function runtimeHarness() {
 const sessions=[];
 const createMcpTools=vi.fn(async()=>[]); // MCP transport/tool execution deliberately excluded from this experiment.
 const adapter=createPiRuntimeAdapter({skillMaterializer:createSkillMaterializer({root}),createMcpTools,
  createSession:async options=>{
   const session={options,prompt:vi.fn(async()=>{trace.push('prompt')}),dispose:vi.fn(async()=>{}),subscribe:()=>()=>{},snapshot:()=>({id:options.id,transcript:[{role:'assistant',status:'complete',content:[{type:'text',text:'  raw result\n'}]}]})};
   sessions.push(session);return session;
  }});
 const manager=createConversationRuntimeManager({autoSweep:false,opener:async(spec,scope)=>{
  const opened=await adapter.open(spec,scope);if(!opened.ok)throw new Error(opened.reason);return opened.runtime;
 }});
 return {manager,sessions,createMcpTools};
}
beforeAll(async()=>{
 await client.run(`create schema ${schema}`);
 await runMigrations(client);
 await client.run("insert into tenants(id,name,status) values ($1,'proof','active'),($2,'other','active')",ids.tenant,ids.otherTenant);
 // Negative baseline: unchanged storage cannot create a task execution context without Chat.
 await expect(client.run("insert into conversations(id,tenant_id,owner_principal_id,status) values ($1,$2,$3,'active')",ids.conversation,ids.tenant,ids.principal)).rejects.toMatchObject({code:'23502'});
 await client.withDriver(sql=>sql.unsafe(readSql));
 for(const [config,tenant] of [[ids.config,ids.tenant],[ids.otherConfig,ids.otherTenant]])
  await client.run("insert into prototype_configurations values ($1,$2,'{}')",config,tenant);
 for(const [id,compiled] of [[ids.versionA,a],[ids.versionB,b]])
  await client.run('insert into prototype_versions values ($1,$2,$3,$4::jsonb,$5)',id,ids.tenant,ids.config,compiled.spec,compiled.sha256);
 for(const integration of [ids.integration,ids.otherIntegration])
  await client.run(`insert into orchestration_integrations(id,tenant_id,name,secret_hash,settings,configuration_id,orchestration_version_id)
  values ($1,$2,'proof','not-a-real-token','{}',$3,$4)`,integration,ids.tenant,ids.config,ids.versionA);
 for(const [id,integration] of [[ids.principal,ids.integration],[ids.otherPrincipal,ids.otherIntegration]])
  await client.run(`insert into principals(id,tenant_id,integration_id,principal_type,subject_hash,status) values ($1,$2,$3,'service',$4,'active')`,id,ids.tenant,integration,'a'.repeat(64));
 await client.run(`insert into conversations(id,tenant_id,source,integration_id,configuration_id,orchestration_version_id,owner_principal_id,status,title)
 values ($1,$2,'orchestration',$3,$4,$5,$6,'active','proof')`,ids.conversation,ids.tenant,ids.integration,ids.config,ids.versionA,ids.principal);
 await client.run(`insert into orchestration_work_items(id,tenant_id,integration_id,alarm_id,state,configuration_revision,settings,principal_id,conversation_id,configuration_id,orchestration_version_id,request_contract,execution_turn_id)
 values ($1,$2,$3,'ALM001','running',1,'{}',$4,$5,$6,$7,'input_v1',$8)`,ids.work,ids.tenant,ids.integration,ids.principal,ids.conversation,ids.config,ids.versionA,ids.turn);
 root=await mkdtemp(join(tmpdir(),'proof-skills-'));
 chatRepos=createPublishingRepositories(client);
 taskRepos={...chatRepos,conversations:createConversationRepository(client),events:createConversationEventRepository(client),summaries:createConversationSummaryRepository(client),
 publishedAppVersions:{get:vi.fn(()=>{throw new Error('Unexpected Chat configuration read')})},
 publishedApps:{get:vi.fn(()=>{throw new Error('Unexpected Chat availability read')})},
 conversationReasoning:{get:vi.fn(()=>{throw new Error('Unexpected Chat reasoning read')})}};
},30000);
const readSql=await readFile('@EXPERIMENT@/storage.sql','utf8');
afterAll(async()=>{
 vi.unstubAllEnvs();
 try{await client.run(`drop schema ${schema} cascade`)}finally{await client.close();if(root)await rm(root,{recursive:true,force:true})}
});

test('1: no Chat rows; task Principal/Conversation/Event/Summary can be stored and read',async()=>{
 for(const table of ['agent_definitions','published_apps','published_app_versions'])
  expect((await client.run(`select count(*)::int as n from ${table}`))[0].n).toBe(0);
 expect((await taskRepos.conversations.get(owner,ids.conversation)).orchestrationVersionId).toBe(ids.versionA);
 const event=await taskRepos.events.append(owner,{conversationId:ids.conversation,eventType:'proof',payload:{text:'evidence'}});
 expect(event.sequence).toBe(1);
 expect((await taskRepos.summaries.insert(owner,{id:randomUUID(),conversationId:ids.conversation,throughSequence:1,modelId:'test',sourceEventCount:1,sourceBytes:10,body:{text:'frozen summary'},createdAt:new Date()})).outcome).toBe('inserted');
 expect((await taskRepos.summaries.getLatest(owner,ids.conversation)).body.text).toBe('frozen summary');
});
