test('2: pure independent compilation freezes model/context/MCP/Skill and rejects unapproved model',()=>{
 expect(a.spec.publishedAppVersionId).toBe(`orv_${ids.versionA}`);
 expect(a.spec.capabilities.mcpServers[0].tools[0].name).toBe('getAlertStats');
 expect(a.spec.capabilities.skills[0].instructionText).toBe('# A');
 expect(a.spec.contextPolicy.maxContextTokens).toBe(16000);
 expect(a.sha256).toBe(compile(ids.versionA).sha256);
 expect(compileRuntimeSpec({publishedAppVersionId:'orv_bad',agent:{prompt:'bad',model:{provider:'fake',modelId:'forbidden'}},catalog:{models:[],tools:[],knowledgeBases:[]}}).ok).toBe(false);
});
test('3: early task resolution enters shared history/context/Runtime/event workflow using frozen version',async()=>{
 vi.stubEnv('PI_AGENT_V2_METRICS','1'); trace.length=0;
 // Integration advances to B; this work remains frozen at A.
 await client.run('update orchestration_integrations set orchestration_version_id=$1 where id=$2',ids.versionB,ids.integration);
 const h=runtimeHarness();
 const list=vi.spyOn(taskRepos.events,'list').mockImplementation(async(...args)=>{
  expect(trace[0]).toBe('resolve');trace.push('history');return createConversationEventRepository(client).list(...args);
 });
 const execute=vi.fn(managedTurnExecutor(h.manager));
 const service=new ConversationService({repositories:taskRepos,resolveExecutionConfiguration:resolveTask,turnExecutor:execute});
 try{
  const result=await service.executeTurn(request);
  expect(result.ok).toBe(true);expect(result.data.outputText).toBe('  raw result\n');
  expect(h.sessions[0].options.systemPrompt).toContain('Task rules A');
  expect(h.sessions[0].options.systemPrompt).not.toContain('Task rules B');
  expect(h.sessions[0].prompt.mock.calls[0][0].text).toBe(request.text);
  const events=await taskRepos.events.list(owner,ids.conversation,{limit:100});
  expect(events.map(e=>e.eventType)).toEqual(expect.arrayContaining(['turn/start','context/snapshot','user/message','assistant/message','turn/end']));
  expect(events.find(e=>e.eventType==='turn/start').payload).toMatchObject({runtimeSpecHash:a.sha256,executionSource:{versionId:`orv_${ids.versionA}`,contract:'input_v1'}});
  const snapshot=events.find(e=>e.eventType==='context/snapshot').payload.snapshot;
  const actual=execute.mock.calls[0][0];
  expect(actual.spec).toEqual(a.spec);
  expect(snapshot).toEqual(estimateContextSnapshot({contextWindow:16000,systemPromptText:a.spec.agent.systemPrompt,conversationMessagesText:[...actual.history.messages.map(m=>m.text),request.text].join('\n'),retrievalContextText:undefined,toolDefinitionsText:''}));
  expect(h.createMcpTools.mock.calls[0][0]).toEqual(a.spec);
  expect(h.createMcpTools.mock.calls[0][1]).toMatchObject({publishedAppId:null,integrationId:ids.integration,publishedAppVersionId:`orv_${ids.versionA}`,executionSource:{kind:'orchestration'}});
  expect(h.sessions[0].options.skills[0].filePath).toContain(`orv_${ids.versionA}`);
  for(const table of ['agent_definitions','published_apps','published_app_versions'])
   expect((await client.run(`select count(*)::int as n from ${table}`))[0].n).toBe(0);
  expect(trace.indexOf('resolve')).toBeLessThan(trace.indexOf('history'));
  expect(trace.indexOf('history')).toBeLessThan(trace.indexOf('prompt'));
 }finally{list.mockRestore();await h.manager.close()}
});
test('3: ownership precedes resolver; bad turn/version/hash cannot start Runtime or restore history',async()=>{
 const executor=vi.fn();
 const service=new ConversationService({repositories:taskRepos,resolveExecutionConfiguration:resolveTask,turnExecutor:executor});
 const before=resolveTask.mock.calls.length;
 expect((await service.executeTurn({...request,principal:{...principal,integrationId:ids.otherIntegration}})).ok).toBe(false);
 expect(resolveTask.mock.calls.length).toBe(before);
 expect((await service.executeTurn({...request,turnId:randomUUID()})).ok).toBe(false);
 await client.run("update prototype_versions set runtime_spec_hash=$1 where id=$2",'0'.repeat(64),ids.versionA);
 const events=vi.spyOn(taskRepos.events,'list');
 try{expect((await service.executeTurn(request)).ok).toBe(false);expect(executor).not.toHaveBeenCalled();expect(events).not.toHaveBeenCalled()}
 finally{events.mockRestore();await client.run('update prototype_versions set runtime_spec_hash=$1 where id=$2',a.sha256,ids.versionA)}
});
test('3: Chat resolver uses same executeTurn body; Chat suspension does not gate task resolution',async()=>{
 const app=randomUUID(),version=randomUUID(),agent=randomUUID(),p=randomUUID(),conv=randomUUID();
 await client.run("insert into agent_definitions(id,tenant_id,name,revision,draft_config,created_by) values ($1,$2,'chat',1,'{}',$2)",agent,ids.tenant);
 await client.run("insert into published_apps(id,tenant_id,agent_definition_id,public_app_id,name,status,access_mode,created_by) values ($1,$2,$3,$4,'chat','active','anonymous',$2)",app,ids.tenant,agent,`pub_${app}`);
 const chat=compile(version,'CHAT','pav');
 await client.run("insert into published_app_versions(id,tenant_id,published_app_id,version_number,source_agent_revision,snapshot,runtime_spec,runtime_spec_hash,status,created_by) values ($1,$2,$3,1,1,'{}',$4::jsonb,$5,'ready',$2)",version,ids.tenant,app,chat.spec,chat.sha256);
 await client.run("insert into principals(id,tenant_id,published_app_id,principal_type,subject_hash,status) values ($1,$2,$3,'service',$4,'active')",p,ids.tenant,app,'c'.repeat(64));
 await client.run("insert into conversations(id,tenant_id,published_app_id,published_app_version_id,owner_principal_id,status,title) values ($1,$2,$3,$4,$5,'active','chat')",conv,ids.tenant,app,version,p);
 const h=runtimeHarness();
 const chatService=new ConversationService({repositories:chatRepos,turnExecutor:managedTurnExecutor(h.manager),resolveExecutionConfiguration:async(scope,record)=>{
  const v=await chatRepos.publishedAppVersions.get(scope,record.publishedAppVersionId);
  const app=await chatRepos.publishedApps.get(scope,record.publishedAppId);
  return {...v,agentId:app.agentDefinitionId,source:{kind:'chat',versionId:record.publishedAppVersionId}};
 }});
 try{
  expect((await chatService.executeTurn({principal:{...principal,publishedAppId:app,integrationId:undefined,principalId:p},conversationId:conv,text:'hello'})).ok).toBe(true);
  expect(h.sessions[0].options.systemPrompt).toContain('Task rules CHAT');
  await client.run("update published_apps set status='suspended' where id=$1",app);
  const taskService=new ConversationService({repositories:taskRepos,resolveExecutionConfiguration:resolveTask,turnExecutor:managedTurnExecutor(h.manager)});
  expect((await taskService.executeTurn(request)).ok).toBe(true);
  expect(h.sessions.at(-1).options.systemPrompt).toContain('Task rules A');
 }finally{await h.manager.close()}
});
test('4: real cache reuses A, rebuilds A to B; Skill directories/hash remain isolated',async()=>{
 const h=runtimeHarness();
 const scope={...owner,conversationId:randomUUID(),publishedAppId:null,publishedAppVersionId:a.spec.publishedAppVersionId};
 try{
  const first=await h.manager.acquire(a.spec,scope);
  expect((await h.manager.acquire(a.spec,scope)).created).toBe(false);
  const second=await h.manager.acquire(b.spec,{...scope,publishedAppVersionId:b.spec.publishedAppVersionId});
  expect(second.created).toBe(true);expect(second.runtime).not.toBe(first.runtime);
  expect(h.sessions[0].dispose).toHaveBeenCalledTimes(1);
  const [pa,pb]=h.sessions.map(s=>s.options.skills[0].filePath);
  expect(pa).not.toBe(pb);expect(await readFile(pa,'utf8')).toBe('# A');expect(await readFile(pb,'utf8')).toBe('# B');
  const mtime=(await stat(pa)).mtimeMs;
  await createSkillMaterializer({root}).materialize(a.spec);
  expect((await stat(pa)).mtimeMs).toBe(mtime);
  expect(a.sha256).not.toBe(b.sha256);
  const sameBody=compile(ids.versionB);
  expect(a.sha256).not.toBe(sameBody.sha256); // version identity itself participates in hash
 }finally{await h.manager.close()}
});
