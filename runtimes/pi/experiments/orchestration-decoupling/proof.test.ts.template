import { randomUUID } from 'node:crypto';
import { readFile, mkdtemp, rm, stat } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { beforeAll, afterAll, expect, test, vi } from 'vitest';
import { ConversationService } from './service.ts';
import { createConversationRepository } from './conversations.ts';
import { createConversationEventRepository } from './conversation-events.ts';
import { createConversationSummaryRepository } from './conversation-summaries.ts';
import { PostgresClient } from '@SOURCE@/persistence/postgres/client.ts';
import { runMigrations } from '@SOURCE@/persistence/postgres/migrate.ts';
import { createPublishingRepositories } from '@SOURCE@/persistence/postgres/repositories/index.ts';
import { compileRuntimeSpec } from '@SOURCE@/publishing/runtime-spec/compiler.ts';
import { canonicalJson, sha256Hex } from '@SOURCE@/publishing/runtime-spec/hash.ts';
import { createSkillMaterializer } from '@SOURCE@/publishing/runtime/skill-materializer.ts';
import { createPiRuntimeAdapter } from '@SOURCE@/runtime/pi-runtime-adapter.ts';
import { createConversationRuntimeManager } from '@SOURCE@/runtime/conversation-runtime-manager.ts';
