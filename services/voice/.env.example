PI_VOICE_HOST=127.0.0.1
PI_VOICE_PORT=18876
PI_VOICE_TOKEN=replace-with-a-random-local-token
PI_VOICE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
PI_VOICE_DEVICE=cuda:0
PI_VOICE_DTYPE=bfloat16
PI_VOICE_ATTENTION=flash_attention_2
PI_VOICE_MAX_CONCURRENCY=1
PI_VOICE_MAX_TEXT_LENGTH=4000
PI_VOICE_ARTIFACT_DIR=~/.pi/agent/audio/artifacts

