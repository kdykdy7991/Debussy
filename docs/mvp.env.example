# Multi-User Publishing MVP —— 环境配置模板（TASK-039）
# 复制为 .env 并替换所有 <...> 占位；secret 以文件路径挂载（勿写明文到 env/日志）。

# ---- 主开关 ----
PI_PUBLISHING_ENABLED=true

# ---- 存储 ----
PI_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/app
PI_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 控制面（内部管理员租户）----
PI_BOOTSTRAP_TENANT_ID=<tenant-uuid>
PI_BOOTSTRAP_TENANT_NAME=my-platform
# 平台管理员令牌文件（>=32 字符；constant-time 比较；绝不入日志）
PI_CONTROL_ADMIN_TOKEN_FILE=/run/secrets/control-admin-token

# ---- Embed 身份 / 令牌 ----
PI_EMBED_ISSUER=https://<plane-origin>
# 匿名身份 HMAC pepper（泄漏=可推导匿名身份）
PI_EMBED_SUBJECT_PEPPER=<64+ random hex>
# Ed25519 签名密钥对 + kid（Access Token）
PI_EMBED_ACCESS_TOKEN_PRIVATE_KEY_FILE=/run/secrets/embed-access-private.pem
PI_EMBED_ACCESS_TOKEN_PUBLIC_KEY_FILE=/run/secrets/embed-access-public.pem
PI_EMBED_ACCESS_TOKEN_KEY_ID=kid-2026-01
PI_EMBED_ACCESS_TOKEN_TTL_SECONDS=600

# ---- signed-user（PD-19 默认关闭：不配置即禁用）----
# PI_EMBED_LAUNCH_TOKEN_AUDIENCE=skdy-embed
# PI_EMBED_LAUNCH_TOKEN_ALLOWED_ISSUERS=https://host.example.com

# ---- 附件对象存储（S3 兼容；缺省 → 上传端点 503，不落到本地磁盘）----
PI_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
PI_OBJECT_STORE_REGION=us-east-1
PI_OBJECT_STORE_BUCKET=pi-attachments
PI_OBJECT_STORE_ACCESS_KEY_ID=<minio-access-key>
PI_OBJECT_STORE_SECRET_ACCESS_KEY=<minio-secret-key>

# ---- 上传配额（默认 100MB/500MB/2GB）----
# PI_EMBED_UPLOAD_QUOTA_CONVERSATION_BYTES=104857600
# PI_EMBED_UPLOAD_QUOTA_PRINCIPAL_BYTES=524288000
# PI_EMBED_UPLOAD_QUOTA_APP_BYTES=2147483648

# ---- 容量压测门控（可选 CI，非默认）----
# PI_CAPACITY_LOAD=1